# Server-only InsForge values. Never expose these in the browser.
INSFORGE_URL=https://your-project.region.insforge.app
INSFORGE_API_KEY=replace_with_project_api_key
GROQ_API_KEY=gsk_xxxxxxxx
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# GCP media storage. Two supported auth modes (pick ONE):
#   MODE A (SA JSON key): set GOOGLE_APPLICATION_CREDENTIALS to the SA JSON path.
#   MODE B (User ADC + SignBlob, org-policy-safe): run "gcloud auth application-default login"
#     in your shell ONCE, then set GCS_SERVICE_ACCOUNT_EMAIL to the SA email.
#     The SDK calls IAM signBlob on that SA (no local key file ever exists).
GCP_PROJECT_ID=your-gcp-project-id
GCS_MEDIA_BUCKET=your-private-media-bucket
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json
GCS_SERVICE_ACCOUNT_EMAIL=meeting-assistant-storage-2026@your-gcp-project-id.iam.gserviceaccount.com

# Optional operational limits for the MVP.
MEDIA_MAX_UPLOAD_BYTES=524288000
MEDIA_SIGNED_URL_TTL_MINUTES=15
DRY_RUN=true

GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_REPO=owner/repo

# Optional: Slack incoming webhook for meeting recap after dispatch
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
