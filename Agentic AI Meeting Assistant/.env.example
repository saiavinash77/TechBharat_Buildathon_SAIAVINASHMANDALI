# Server-only InsForge values. Never expose these in the browser.
INSFORGE_URL=https://your-project.region.insforge.app
INSFORGE_API_KEY=replace_with_project_api_key
GROQ_API_KEY=gsk_xxxxxxxx
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# GCP media storage. The service account needs access only to this bucket.
GCP_PROJECT_ID=your-gcp-project-id
GCS_MEDIA_BUCKET=your-private-media-bucket
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json

# Optional operational limits for the MVP.
MEDIA_MAX_UPLOAD_BYTES=524288000
MEDIA_SIGNED_URL_TTL_MINUTES=15
DRY_RUN=true

GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_REPO=owner/repo
